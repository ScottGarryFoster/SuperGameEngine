    <Namespace Name="SuperGameTools" />
    <EnumComment>
        Describes what updated (or how) when the scene updates.
    </EnumComment>
    <EnumName Name="SceneUpdateAction">
        <Unknown HideFromLists="true">
            Only used for unsuccessful parsing.
