<AssetMetaData>
    <Template AssetFileType="ImageAsset">
        <MatchingCriteria UniversalObjectDataTemplateMatchingStyle="Extension">
            <Extension value=".png" />
        </MatchingCriteria>
        <BaseFileTemplate UniversalObjectDataTemplateCreationMethod="Simple">
            <Asset>
                <Strings>
                    <String Key="GameAssetName" Value="{FilepathDisplayName}" />
                </Strings>
            </Asset>
        </BaseFileTemplate>
    </Template>
    <AssetLayout>
        <Data Type="String" EnumFilter="SplitUVMethod" Map="TextureUVMethod" MapType="Single" />
        <Data Type="Vector4I" Map="TextureUV" MapType="Array">
            <Require DataMap="TextureUVMethod" MapType="String" Value="Predefined" When="Match" />
        </Data>
        <Data Type="Vector2I" Map="UniformTextureUV">
            <Require DataMap="TextureUVMethod" MapType="String" Value="UniformByPixel" When="Match" />
        </Data>
    </AssetLayout>
</AssetMetaData>